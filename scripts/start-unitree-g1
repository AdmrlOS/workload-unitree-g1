#!/bin/bash
# One supervised system userspace: robot services + optional child-image CMD.
set -Eeuo pipefail
umask 022
mkdir -p /run/sshd /run/unitree-g1 /var/log/unitree-g1 /unitree/var/run
export GST_REGISTRY=/run/unitree-g1/gstreamer-registry.bin
export CYCLONEDDS_URI=/unitree/module/video_hub_pc4/cyclonedds.xml
log() { printf '%s %s\n' "$(date -u --iso-8601=seconds)" "$*" | tee -a /var/log/unitree-g1/boot.log; }
SSHD_PID='' APP_PID='' LOG_PID=''
cleanup() {
    trap - EXIT TERM INT
    log 'stopping application and Unitree services'
    if [[ -n "$APP_PID" ]]; then kill -TERM -- "-$APP_PID" 2>/dev/null || true; fi
    # Stop the manager first so it cannot relaunch a module during teardown.
    timeout 4 /etc/init.d/master_service stop >>/var/log/unitree-g1/boot.log 2>&1 || true
    /unitree/sbin/start-stop-daemon --stop --pidfile=/unitree/var/run/videohub_pc4.pid \
        --retry TERM/5/KILL/1 >>/var/log/unitree-g1/boot.log 2>&1 || true
    if [[ -n "$APP_PID" ]]; then
        for _ in {1..5}; do kill -0 -- "-$APP_PID" 2>/dev/null || break; sleep 1; done
        kill -KILL -- "-$APP_PID" 2>/dev/null || true
        wait "$APP_PID" 2>/dev/null || true
    fi
    for pid in "$SSHD_PID" "$LOG_PID"; do
        [[ -z "$pid" ]] || kill "$pid" 2>/dev/null || true
    done
}
trap cleanup EXIT
trap 'exit 0' TERM INT

interval=${UNITREE_WATCHDOG_INTERVAL:-5}
[[ "$interval" =~ ^[1-9][0-9]*$ ]] || { log 'invalid UNITREE_WATCHDOG_INTERVAL'; exit 2; }

ssh-keygen -A
/usr/sbin/sshd -t
/usr/sbin/sshd -D -e &
SSHD_PID=$!

# These stack-owned PID files can outlive a process on Admiral's reused rootfs.
rm -f /unitree/var/run/master_service.pid \
    /unitree/var/run/videohub_pc4.pid /run/unitree-g1/camera.json "$GST_REGISTRY"
case "${UNITREE_HARDWARE_CHECKS:-1}" in
    1) /usr/local/bin/unitree-g1-check.py platform ;;
    0) log 'hardware preflight disabled: development/CI mode, not a hardware readiness result' ;;
    *) log 'UNITREE_HARDWARE_CHECKS must be 0 or 1'; exit 2 ;;
esac

# Follow module logs into Admiral's dashboard. Do not pipe daemon launches
# through tee: their inherited descriptors would leave the pipe open forever.
touch /var/log/videohub-warmup.log
tail -n 0 -F /var/log/videohub-warmup.log &
LOG_PID=$!
log 'starting master_service (software updates are managed by Admiral)'
/etc/init.d/master_service start >>/var/log/unitree-g1/boot.log 2>&1
# Bound startup by observed service readiness, not runner/board speed.
for _ in {1..30}; do
    /etc/init.d/master_service status >/dev/null 2>&1 && break
    sleep 1
done
/etc/init.d/master_service status
timeout 10 /unitree/sbin/mscli listservice || true

if (($#)); then
    # argv is the child Dockerfile CMD; never eval an environment string.
    # Admiral starts at / regardless of WORKDIR.
    cd "${UNITREE_APP_DIR:-/opt/app}"
    log "starting user application: $1"
    if [[ -n "${UNITREE_APP_USER:-}" ]]; then
        setsid setpriv --reuid="$UNITREE_APP_USER" --regid="$(id -g "$UNITREE_APP_USER")" \
            --init-groups -- "$@" &
    else
        setsid -- "$@" &
    fi
    APP_PID=$!
fi

while true; do
    /etc/init.d/master_service status >/dev/null 2>&1 || { log 'FATAL: master_service died'; exit 1; }
    kill -0 "$SSHD_PID" 2>/dev/null || { log 'FATAL: sshd died'; exit 1; }
    if [[ -n "$APP_PID" ]] && ! kill -0 "$APP_PID" 2>/dev/null; then
        code=0
        wait "$APP_PID" || code=$?
        log "FATAL: user application exited ($code); restarting the whole userspace"
        exit 1
    fi
    sleep "$interval" &
    wait $! || true
done
