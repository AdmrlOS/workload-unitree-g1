#!/bin/bash
# unitree-g1-status — diagnostic CLI, same role as workload-cuda-debug's
# `cuda-debug` script: one command to dump everything needed to file a
# useful bug report or confirm the appliance is healthy after a deploy.
set -uo pipefail

section() { printf '\n--- %s ---\n' "$*"; }

case "${1:-inspect}" in
inspect)
    date -u --iso-8601=seconds
    uname -a
    id

    section "Board identity (Nano and NX have different video capabilities)"
    for path in /sys/firmware/devicetree/base/model /sys/firmware/devicetree/base/chosen/ids; do
        if [ -r "$path" ]; then printf '%s: ' "$path"; tr '\000' ' ' < "$path"; echo; fi
    done

    section "Unitree module versions"
    if [ -f /unitree/robot/pkg/version/version.json ]; then
        jq . /unitree/robot/pkg/version/version.json 2>/dev/null || cat /unitree/robot/pkg/version/version.json
    else
        echo "MISSING /unitree/robot/pkg/version/version.json"
    fi

    section "mscli listservice"
    timeout 10 /unitree/sbin/mscli listservice 2>&1 || echo "mscli not available / master_service not responding"

    section "Runtime library resolution (master_service)"
    ldd /unitree/module/master_service/master_service 2>&1 | grep -E 'not found|libcrypto|libssl|libddsc' || \
        ldd /unitree/module/master_service/master_service 2>&1

    section "CycloneDDS runtime"
    ldconfig -p | grep -i libddsc || echo "libddsc.so.0 NOT in ldconfig cache"

    section "L4T GStreamer hardware plugins"
    if command -v gst-inspect-1.0 >/dev/null 2>&1; then
        for elem in nvv4l2h264enc nvvidconv nvjpegenc; do
            gst-inspect-1.0 "$elem" >/dev/null 2>&1 && echo "OK   $elem" || echo "MISSING $elem"
        done
    else
        echo "gst-inspect-1.0 not installed in this image"
    fi

    section "Camera supervisor"
    cat /run/unitree-g1/camera.json 2>/dev/null || true
    section "Camera device nodes"
    if [ -e /dev/rlsen0 ]; then
        ls -l /dev/rlsen0
        readlink -f /dev/rlsen0
    else
        echo "MISSING /dev/rlsen0: check workload camera discovery and BSP USB/UVC support"
    fi
    v4l2-ctl --list-devices 2>&1 || echo "no V4L2 camera detected"
    find /dev -maxdepth 1 -name 'video*' -exec ls -ldn {} + 2>/dev/null || true

    section "Jetson/Tegra device nodes (informational — Admiral owns these)"
    find /dev -maxdepth 4 \( -name 'nvmap' -o -name 'nvgpu' -o -path '/dev/nvgpu/*' -o -name 'nvhost*' -o -path '/dev/dri/*' \) \
        -exec ls -ldn {} + 2>/dev/null || true

    section "Network (expects hostNetwork: true — see docs/admiral-mapping.md)"
    ip -brief addr show 2>&1 || ifconfig 2>&1
    echo "Expected static IP for this board (set at the Admiral network layer, not by this container): 192.168.123.164/24 on the physical eth0-equivalent NIC"
    ip route show 2>&1 | grep -i 230.1.1.1 || echo "no explicit route for video multicast group 230.1.1.1 (may still work via default multicast handling)"

    section "Memory"
    free -h
    ;;

check)
    exec /usr/local/bin/unitree-g1-check.py ready
    ;;

platform)
    exec /usr/local/bin/unitree-g1-check.py platform
    ;;

video)
    exec /usr/local/bin/unitree-g1-check.py video
    ;;

services)
    timeout 10 /unitree/sbin/mscli listservice
    ;;

modules)
    # Build-time provenance, not a live module updater query.
    jq . /unitree/robot/pkg/version/version.json
    ;;

camera)
    v4l2-ctl --list-devices
    ;;

*)
    echo "Usage: unitree-g1-status [inspect|check|platform|video|services|modules|camera]" >&2
    exit 2
    ;;
esac
